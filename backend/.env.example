APP_NAME="EcoStore API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.storeseco.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL on shared hosting) ───────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@storeseco.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── PayMob (Unified Checkout / Intention API) ─────────────────────────────────
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_CARD_INTEGRATION_ID=23389
PAYMOB_APPLE_INTEGRATION_ID=23388
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=SAR

# ── WooCommerce ───────────────────────────────────────────────────────────────
WOOCOMMERCE_URL=https://storeseco.com
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# ── Snapchat Conversions API (Events Manager → إعدادات البكسل/التطبيق) ────────
SNAPCHAT_APP_ID=
SNAPCHAT_ACCESS_TOKEN=
